{
  "title": "Wisdoverse Forge — overview",
  "uid": "agentforge-overview",
  "tags": ["agentforge", "ops"],
  "schemaVersion": 39,
  "version": 3,
  "timezone": "",
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": { "text": "Prometheus", "value": "prometheus" }
      },
      {
        "name": "path",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "$datasource" },
        "query": "label_values(http_requests_total{service!=\"orchestrator\"}, path)",
        "refresh": 2,
        "includeAll": true,
        "multi": true
      }
    ]
  },
  "panels": [
    {
      "title": "Request rate (req/s)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum by (path) (rate(http_requests_total{path=~\"$path\",service!=\"orchestrator\"}[5m]))",
          "legendFormat": "{{ path }}"
        }
      ]
    },
    {
      "title": "5xx error rate (% of requests)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.005 },
              { "color": "red", "value": 0.01 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "((sum by (path) (rate(http_requests_total{status=~\"5..\",path=~\"$path\",service!=\"orchestrator\"}[5m])) or (0 * sum by (path) (rate(http_requests_total{path=~\"$path\",service!=\"orchestrator\"}[5m])))) / sum by (path) (rate(http_requests_total{path=~\"$path\",service!=\"orchestrator\"}[5m]))) and sum by (path) (rate(http_requests_total{path=~\"$path\",service!=\"orchestrator\"}[5m])) > 0",
          "legendFormat": "{{ path }}"
        }
      ]
    },
    {
      "title": "Latency p50 / p95 / p99",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "gridPos": { "x": 0, "y": 8, "w": 24, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le, path) (rate(http_request_duration_seconds_bucket{path=~\"$path\",service!=\"orchestrator\"}[5m])))",
          "legendFormat": "p50 {{ path }}"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, path) (rate(http_request_duration_seconds_bucket{path=~\"$path\",service!=\"orchestrator\"}[5m])))",
          "legendFormat": "p95 {{ path }}"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le, path) (rate(http_request_duration_seconds_bucket{path=~\"$path\",service!=\"orchestrator\"}[5m])))",
          "legendFormat": "p99 {{ path }}"
        }
      ]
    },
    {
      "title": "Orchestrator outbox oldest-unpublished age (s)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [{ "expr": "agentforge_orchestration_outbox_oldest_age_seconds" }]
    },
    {
      "title": "Orchestrator outbox backlog (unpublished)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "targets": [{ "expr": "agentforge_orchestration_outbox_backlog" }]
    },
    {
      "title": "Server resident memory (bytes)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "gridPos": { "x": 0, "y": 24, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "targets": [
        {
          "expr": "process_resident_memory_bytes{job=\"agentforge-server\"}",
          "legendFormat": "server"
        },
        {
          "expr": "process_resident_memory_bytes{job=\"agentforge-orchestrator\"}",
          "legendFormat": "orchestrator"
        }
      ]
    },
    {
      "title": "Container restarts (10m)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "gridPos": { "x": 12, "y": 24, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "increase(container_restart_count{name=~\"agentforge-(server|orchestrator)\"}[10m])",
          "legendFormat": "{{ name }}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 3 }
            ]
          }
        }
      }
    },
    {
      "title": "Observed API 5xx (30-day lookback)",
      "description": "This panel covers all API paths and ignores the path filter. A low ratio does not prove complete 30-day coverage. See docs/runbooks/observability-slo.md#api-availability.",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "gridPos": { "x": 0, "y": 32, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "((sum(rate(http_requests_total{status=~\"5..\",service!=\"orchestrator\"}[30d])) or vector(0)) / sum(rate(http_requests_total{service!=\"orchestrator\"}[30d]))) and sum(rate(http_requests_total{service!=\"orchestrator\"}[30d])) > 0",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "noValue": "No measurement",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.005 },
              { "color": "red", "value": 0.01 }
            ]
          }
        }
      }
    }
  ]
}
