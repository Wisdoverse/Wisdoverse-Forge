# =============================================================================
#                 WISDOVERSE FORGE DOCKER CONFIGURATION
# =============================================================================
#
# Docker-specific Environment Configuration
# Version: 4.0.0
# Last Updated: 2026-02-12
#
# SETUP:
#   1. Copy this file: cp .env.example .env
#   2. Update values for your environment
#   3. Run: make dev (or make prod, make prod-ext)
#   4. After the app is running, create the initial owner/admin account through
#      the web setup flow. No default application admin account is configured here.
#
# NOTE: This file is for Docker deployment configuration only.
# Application settings are in the root .env file (../.env.example)
#
# =============================================================================

# -----------------------------------------------------------------------------
# DEPLOYMENT MODE
# -----------------------------------------------------------------------------

# Image version tag
# Default: latest
VERSION=latest

# Active deployment profile(s): dev | prod | external | tools | backup | storage
# Multiple: COMPOSE_PROFILES=external,storage
# COMPOSE_PROFILES=external

# -----------------------------------------------------------------------------
# HOST USER MAPPING
# -----------------------------------------------------------------------------
# Map container user to host user for proper file permissions
# Find your values with: id claude

# Claude user home directory on host
CLAUDE_HOME=/home/claude

# Claude user ID on host (id -u claude)
CLAUDE_UID=1011

# Claude group ID on host (id -g claude)
CLAUDE_GID=1012

# -----------------------------------------------------------------------------
# NETWORK
# -----------------------------------------------------------------------------

# Server port mapping (host:container)
AGENTFORGE_PORT=4003

# Bind address
# Development: 0.0.0.0 (all interfaces)
# Production:  127.0.0.1 (behind reverse proxy)
BIND_ADDRESS=127.0.0.1

# External network name (for 'external' profile)
# Used when connecting to external services
EXTERNAL_NETWORK=external-network

# Nginx ports (for 'prod' profile)
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# -----------------------------------------------------------------------------
# RESOURCE LIMITS
# -----------------------------------------------------------------------------

# Container CPU limit
CPU_LIMIT=2

# Container memory limit
MEMORY_LIMIT=512M

# -----------------------------------------------------------------------------
# NATS JetStream (message broker for event pipeline)
# -----------------------------------------------------------------------------

# Issue #38 phase 2: NATS authenticates agent sidecars through the Rust API
# auth callout service. The backend user is unrestricted within the AGENTFORGE
# account; each sidecar receives per-agent credentials at runtime. A SYS user is
# used for monitoring and targeted revocation.
#
# Generate the passwords, seeds, and matching public keys with:
#   docs/runbooks/nats-auth.md
#
# Legacy single-token auth (`NATS_TOKEN`) is no longer read.
NATS_BACKEND_PASSWORD=
NATS_AUTH_SERVICE_PASSWORD=
NATS_SYS_PASSWORD=
NATS_CALLOUT_ISSUER_SEED=
NATS_CALLOUT_ACCOUNT_SIGNING_KEY_SEED=
NATS_CALLOUT_XKEY_SEED=
NATS_CALLOUT_ISSUER_PUBLIC=
NATS_CALLOUT_XKEY_PUBLIC=
NATS_SERVER_NAME=agentforge-primary

# NATS connection URLs — computed by default from the backend password above.
# Override only when pointing at an external NATS cluster whose operator
# configured different usernames.
# NATS_URL=nats://backend:<password>@nats:4222
# NATS_AGENT_URL=nats://nats:4222

# NATS ports (host mapping)
NATS_PORT=4222
NATS_MONITOR_PORT=8222

# -----------------------------------------------------------------------------
# PLATFORM SERVICE (Go gRPC — always runs alongside agentforge)
# -----------------------------------------------------------------------------

# gRPC port (host mapping)
PLATFORM_GRPC_PORT=50052

# Resource limits for platform service
PLATFORM_CPU_LIMIT=1
PLATFORM_MEMORY_LIMIT=256M

# -----------------------------------------------------------------------------
# DATABASE (overridden by compose.dev.yml/compose.prod.yml; set here for 'external' profile)
# -----------------------------------------------------------------------------

# Enable database (set to false for file-based storage)
USE_DATABASE=true

# PostgreSQL password ('prod' profile)
# Generate: openssl rand -base64 32
POSTGRES_PASSWORD=

# External database connection ('external' profile)
# DATABASE_URL=postgres://user:pass@host:5432/dbname
DB_HOST=
DB_PORT=5432
DB_NAME=agentforge
DB_USER=agentforge
DB_PASSWORD=
DB_SSL=false
DB_POOL_MAX=20

# -----------------------------------------------------------------------------
# REDIS (overridden by compose.dev.yml/compose.prod.yml; set here for 'external' profile)
# -----------------------------------------------------------------------------

# Redis URL (external)
# REDIS_URL=redis://host:6379
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# -----------------------------------------------------------------------------
# SECURITY
# -----------------------------------------------------------------------------

# JWT signing secret (required for production)
# Generate: openssl rand -base64 64
JWT_SECRET=

# Allowed origins for CORS and WebSocket (comma-separated)
# Production example: forge.example.com,*.forge.example.com
AGENTFORGE_ALLOWED_ORIGINS=localhost,127.0.0.1

# Trust reverse proxy headers
# Set to "true" when behind nginx, traefik, or load balancer
AGENTFORGE_TRUST_PROXY=true

# -----------------------------------------------------------------------------
# STORAGE (MinIO object storage for attachments)
# -----------------------------------------------------------------------------

# Storage provider: local | minio
STORAGE_PROVIDER=local

# Local attachment storage path inside the Rust API container.
# The production compose file mounts a named volume here so the API can keep a
# read-only root filesystem.
STORAGE_LOCAL_PATH=/var/lib/agentforge/uploads

# MinIO configuration (when STORAGE_PROVIDER=minio)
# Start with: make prod-storage
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=agentforge

# MinIO host ports
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# OCI Registry for devcontainer images
REGISTRY_URL=http://registry:5000
REGISTRY_PORT=5000

# -----------------------------------------------------------------------------
# ERROR TRACKING (Sentry)
# -----------------------------------------------------------------------------

# Sentry DSN for error tracking
# SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# -----------------------------------------------------------------------------
# BILLING (Stripe, optional)
# -----------------------------------------------------------------------------

# Configure both server-side secrets to enable billing write paths. When unset,
# checkout, portal, cancellation, and webhook handling fail closed.
# Webhook endpoint: ${APP_URL}/api/billing/webhook
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PUBLISHABLE_KEY=

# -----------------------------------------------------------------------------
# API KEY SECURITY
# -----------------------------------------------------------------------------

# Salt for API key hashing
# Generate: openssl rand -base64 32
API_KEY_SALT=

# -----------------------------------------------------------------------------
# LLM GATEWAY (Multi-Provider Support)
# -----------------------------------------------------------------------------

# Enable LLM Gateway for multi-provider routing
LLM_GATEWAY_ENABLED=true

# Default LLM provider: anthropic | openai | google | ollama
LLM_DEFAULT_PROVIDER=anthropic

# Default routing strategy: specified | cost | latency | failover
LLM_DEFAULT_ROUTING_STRATEGY=specified

# Encryption key for API keys (64 hex characters)
# Generate: openssl rand -hex 32
# If not set, derived from JWT_SECRET via HKDF
LLM_ENCRYPTION_KEY=

# Circuit breaker settings
LLM_CIRCUIT_BREAKER_THRESHOLD=5
LLM_CIRCUIT_BREAKER_RESET_MS=30000

# -----------------------------------------------------------------------------
# CONTAINER RUNTIME (Docker-based agent isolation)
# -----------------------------------------------------------------------------

# Enable containerized agent runtime
CONTAINER_ENABLED=false

# Agent container image
CONTAINER_AGENT_IMAGE=agentforge-agent:latest

# Public release registry for pre-built redistributable CLI tool images.
# `make update-agents` pulls agent-base plus agent-opencode/codex/gemini from
# this namespace and tags them locally as agentforge-agent:<tool>.
# Claude Code is not published in public images; build it locally with
# `make build-agent CLI_TOOL=claude` after accepting the vendor terms, or pull
# it from a private registry only when your terms permit redistribution.
AGENT_REGISTRY=ghcr.io/wisdoverse/wisdoverse-forge

# Image tag pulled by `make prod-ext-pull` and `make pull-server-images`.
# Tracks GHCR's tag scheme:
#   * `main`       - latest main-branch build (default for staging-shape locals)
#   * `edge`       - alias for the latest main build
#   * `<version>`  - immutable release pin (e.g. `0.2.0`)
#   * `sha-xxxxxxx` - immutable per-commit pin
GHCR_IMAGE_TAG=main

# Local image tags used by the Rust API when starting Container CLI agents.
CONTAINER_IMAGE_CLAUDE=agentforge-agent:claude
CONTAINER_IMAGE_OPENCODE=agentforge-agent:opencode
CONTAINER_IMAGE_CODEX=agentforge-agent:codex
CONTAINER_IMAGE_GEMINI=agentforge-agent:gemini

# Docker socket path
CONTAINER_SOCKET_PATH=/var/run/docker.sock

# Docker network for agent containers
CONTAINER_NETWORK=agentforge-agents

# Server URL for agent containers to reach the server
CONTAINER_SERVER_URL=http://agentforge:4003

# Allowed host mount prefixes for agent containers
CONTAINER_ALLOWED_MOUNT_PREFIXES=/home,/root

# Resource limits for agent containers
CONTAINER_CPU_LIMIT=1
CONTAINER_MEMORY_LIMIT_MB=512
CONTAINER_PIDS_LIMIT=256

# Docker group ID on host (for container socket access)
# Find with: getent group docker | cut -d: -f3
DOCKER_GID=998

# Per-tool system fallback API keys (injected when user has no personal credentials).
# Each key is used only for its corresponding CLI tool — no cross-tool sharing.
# CONTAINER_ANTHROPIC_API_KEY=sk-ant-...   # Claude, OpenCode
# CONTAINER_GOOGLE_API_KEY=AIza...         # Gemini
# CONTAINER_OPENAI_API_KEY=sk-...          # Codex

# Workspace root for per-user project isolation
AGENTFORGE_WORKSPACE_ROOT=/data/agentforge/workspaces

# -----------------------------------------------------------------------------
# RUNTIME CONFIGURATION
# -----------------------------------------------------------------------------

# Default runtime type: api | container
RUNTIME_TYPE=container

# -----------------------------------------------------------------------------
# GOVERNED CONTEXT ROLLOUT FLAGS
# -----------------------------------------------------------------------------
#
# Release-gate flags. Keep all four disabled until the release-gate checklist,
# rollback drill, and owner signoffs are attached.
CONTEXT_GOVERNANCE_ENABLED=false
CONTEXT_PREVIEW_ENABLED=false
CONTEXT_INJECTION_ENABLED=false
CONTEXT_ANALYTICS_ENABLED=false

# -----------------------------------------------------------------------------
# SSO / OAUTH PROVIDERS (optional)
# -----------------------------------------------------------------------------
# Configure one or more OAuth/OIDC providers for SSO login.
# Standard OIDC providers (Google, Keycloak) use auto-discovery via ISSUER.
# Non-OIDC providers (GitHub) require manual endpoint configuration.

# GitHub OAuth (non-OIDC, manual endpoints)
# Create OAuth App at: https://github.com/settings/developers
# OIDC_GITHUB_CLIENT_ID=
# OIDC_GITHUB_CLIENT_SECRET=
# OIDC_GITHUB_DISPLAY_NAME=GitHub
# OIDC_GITHUB_ICON=github
# OIDC_GITHUB_SCOPE=user:email
# OIDC_GITHUB_AUTHORIZATION_ENDPOINT=https://github.com/login/oauth/authorize
# OIDC_GITHUB_TOKEN_ENDPOINT=https://github.com/login/oauth/access_token
# OIDC_GITHUB_USERINFO_ENDPOINT=https://api.github.com/user

# Google OIDC (standard discovery)
# Create credentials at: https://console.cloud.google.com/apis/credentials
# OIDC_GOOGLE_ISSUER=https://accounts.google.com
# OIDC_GOOGLE_CLIENT_ID=
# OIDC_GOOGLE_CLIENT_SECRET=
# OIDC_GOOGLE_DISPLAY_NAME=Google
# OIDC_GOOGLE_ICON=google

# Keycloak (standard OIDC)
# OIDC_KEYCLOAK_ISSUER=https://keycloak.example.com/realms/agentforge
# OIDC_KEYCLOAK_CLIENT_ID=agentforge-app
# OIDC_KEYCLOAK_CLIENT_SECRET=
# OIDC_KEYCLOAK_DISPLAY_NAME=Enterprise SSO
# OIDC_KEYCLOAK_ICON=building

# Casdoor OIDC (deployed via 'casdoor' profile)
# Start with: make dev-casdoor or make prod-casdoor
OIDC_CASDOOR_ISSUER=http://casdoor:8000
OIDC_CASDOOR_CLIENT_ID=agentforge-client
OIDC_CASDOOR_CLIENT_SECRET=agentforge-secret
OIDC_CASDOOR_DISPLAY_NAME=Wisdoverse Forge SSO

# -----------------------------------------------------------------------------
# EMAIL / SMTP (optional, for email verification and password reset)
# -----------------------------------------------------------------------------

# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=Wisdoverse Forge <noreply@example.com>
# SMTP_SECURE=false

# Application URL (required for SSO callbacks and email links)
# APP_URL=https://forge.example.com

# Restrict registration to specific email domains (comma-separated)
# ALLOWED_EMAIL_DOMAINS=

# -----------------------------------------------------------------------------
# CASDOOR IDENTITY PROVIDER (profile: casdoor)
# -----------------------------------------------------------------------------
CASDOOR_DB_PASSWORD=casdoor
CASDOOR_PORT=8000
CASDOOR_DB_PORT=5433

# -----------------------------------------------------------------------------
# OPTIONAL SERVICES
# -----------------------------------------------------------------------------

# Deepgram API key for voice input
# Get your key at: https://console.deepgram.com/
# DEEPGRAM_API_KEY=

# -----------------------------------------------------------------------------
# LOGGING
# -----------------------------------------------------------------------------

# Log level: debug | info | warn | error
LOG_LEVEL=info

# Enable debug mode
DEBUG=false

# Docker log driver: json-file | syslog | journald | none
LOG_DRIVER=json-file

# Log rotation
LOG_MAX_SIZE=10m
LOG_MAX_FILE=5

# -----------------------------------------------------------------------------
# HEALTH CHECK
# -----------------------------------------------------------------------------

HEALTHCHECK_INTERVAL=30s
HEALTHCHECK_TIMEOUT=10s
HEALTHCHECK_RETRIES=3
HEALTHCHECK_START_PERIOD=40s

# -----------------------------------------------------------------------------
# FRONTEND DEPLOYMENT
# -----------------------------------------------------------------------------
# Used by scripts/deploy.sh. See docs/deployment/single-host-compose.md for
# the full env-var contract and alternative topologies.

# Absolute path nginx serves the SPA from. REQUIRED for production; required
# for staging unless DEPLOY_ALLOW_LEGACY_DEFAULTS=1 is set as a transition.
# Examples:
#   /var/www/agentforge                                   # generic Linux
#   /www/sites/forge.example.com/index                    # 1Panel-managed host
#   /opt/agentforge/www                                   # legacy default
WEBROOT=/var/www/agentforge

# Frontend deploy strategy: "symlink" (default, atomic via release dirs)
# or "rsync" (overwrite WEBROOT in place; use when nginx refuses symlinks
# or WEBROOT is managed by a panel UI).
FRONTEND_DEPLOY_MODE=symlink

# Owner UID/GID for written files. Match the user nginx (or your control
# panel) expects to own WEBROOT. Common values:
#   33      Debian/Ubuntu www-data
#   101     Alpine nginx
#   1000    Docker default non-root
WEBROOT_OWNER_UID=33
WEBROOT_OWNER_GID=33

# Number of release directories to retain in symlink mode (default: 5).
# KEEP_RELEASES=5

# Optional: pin a specific frontend image (default: agentforge-frontend:${IMAGE_TAG:-latest}).
# FRONTEND_IMAGE=agentforge-frontend:latest

# Optional: override agent CLI list pulled at deploy time.
# AGENT_TOOLS="claude opencode codex gemini"
# REQUIRED_AGENT_TOOL=claude

# Optional: override docker networks created (idempotently) before bring-up.
# AGENTFORGE_NETWORKS="agentforge-agents external-network"

# ── Orchestration ──────────────────────────
# Master kill switch for orchestration module (default: true)
# Set to 'false' to completely disable orchestration routes
ORCHESTRATION_ENABLED=true

# =============================================================================
# PRODUCTION CHECKLIST
# =============================================================================
#
# Before deploying to production:
#
# [ ] Set BIND_ADDRESS=127.0.0.1 (use reverse proxy)
# [ ] Set AGENTFORGE_TRUST_PROXY=true
# [ ] Generate and set JWT_SECRET
# [ ] Generate and set POSTGRES_PASSWORD (if using 'prod' profile)
# [ ] Configure AGENTFORGE_ALLOWED_ORIGINS with actual domains
# [ ] Run 'make setup' to create external Docker networks
# [ ] Set APP_URL to your public URL (required for SSO and email links)
# [ ] Create the initial owner/admin account through the web setup flow
# [ ] Set appropriate MEMORY_LIMIT and CPU_LIMIT
# [ ] Configure SSL certificates in docker/ssl/
# [ ] Configure SSO providers (GitHub/Google/Keycloak) if needed
# [ ] Use Docker secrets for sensitive values in Swarm mode
#
# =============================================================================
