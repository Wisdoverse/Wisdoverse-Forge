# syntax=docker/dockerfile:1.23
# =============================================================================
# Wisdoverse Forge Ephemeral Clone Image
#
# Minimal, single-purpose, least-privilege image that clones ONE git repository
# into a mounted staging directory and exits. It is run by the project_clone
# worker (M5) on a restricted egress network with the per-clone staging dir as
# its ONLY mount and a host-matched short-lived credential delivered via a
# read-only secret mount at /run/secrets/git-credential.
#
# Attack surface is deliberately tiny: git + ca-certificates + openssh-client
# (present for v2 SSH, unused in v1) + tini, and the clone entrypoint. NO Node,
# Python, docker CLI, gh/glab, sidecar, or harness — none of the agent-base
# tooling that would widen the surface for untrusted-repo network I/O.
#
# Build: docker build -f docker/Dockerfile.clone -t agentforge-clone:latest .
#   (or: make build-clone)
# =============================================================================

# Compile the OpenSSH client for Trixie. Do not install Sid runtime packages.
FROM debian:trixie-slim@sha256:a99cfc517144bc59b1978475ec53b46ecabec7e43635402ee5b77cc54cd1b20a AS openssh-builder
WORKDIR /build
COPY docker/scripts/build-openssh-client.sh /usr/local/bin/build-openssh-client.sh
RUN bash /usr/local/bin/build-openssh-client.sh

# The digest pins the Debian Trixie slim input for the clone runtime.
# Use the same runtime distribution as the agent base.
# The UID/GID values below set repository ownership during agent handoff.
FROM debian:trixie-slim@sha256:a99cfc517144bc59b1978475ec53b46ecabec7e43635402ee5b77cc54cd1b20a

LABEL org.opencontainers.image.title="Wisdoverse Forge Clone" \
      org.opencontainers.image.description="Ephemeral least-privilege git clone container" \
      org.opencontainers.image.vendor="Wisdoverse Forge"

# Match the agent base image's agent user UID/GID (Dockerfile.agent-base defaults
# AGENT_UID=1011 / AGENT_GID=1012) so a repo cloned by this container is owned by
# the same uid the agent container later runs as — keeping ownership and git
# safe.directory correct across the one-shot hand-off.
ARG AGENT_UID=1011
ARG AGENT_GID=1012

# Install ONLY what a clone needs. `apt-get dist-upgrade` applies Debian security
# backports on top of the base layer (same hardening as agent-base). tini gives a
# proper PID 1 that reaps zombies and forwards signals for the worker's timeout.
RUN --mount=type=bind,from=openssh-builder,source=/out,target=/tmp/openssh,ro \
    apt-get update && apt-get -y dist-upgrade \
    && apt-get install -y --no-install-recommends \
       git ca-certificates tini systemd-standalone-sysusers \
    /tmp/openssh/openssh-client_*.deb /tmp/openssh/openssh-common_*.deb \
    && printf '%s\n' 'deb [signed-by=/usr/share/keyrings/debian-archive-keyring.gpg] https://deb.debian.org/debian trixie-backports main' > /etc/apt/sources.list.d/forge-backports.list \
    && apt-get update \
    && apt-get install -y -t trixie-backports --no-install-recommends --no-remove \
       libcurl3t64-gnutls libcurl4-gnutls \
    && for pkg in libcurl3t64-gnutls libcurl4-gnutls; do \
         dpkg --compare-versions "$(dpkg-query -W -f='${Version}' "$pkg")" ge 8.21.0 || exit 1; \
       done \
    && test "$(dpkg-query -W -f='${Version}' openssh-client)" = '1:10.5p1-1~forge13+1' \
    && test "$(dpkg-query -W -f='${Version}' openssh-common)" = '1:10.5p1-1~forge13+1' \
    && test "$(dpkg-query -W -f='${db:Status-Status}' systemd-standalone-sysusers)" = 'installed' \
    && ! dpkg-query -W -f='${db:Status-Status}\n' systemd libsystemd-shared 2>/dev/null | grep -qx installed \
    && ! command -v curl \
    && rm -f /etc/apt/sources.list.d/forge-backports.list \
    && rm -rf /var/lib/apt/lists/*

# Non-root agent user with the same UID/GID as the agent base image.
# --non-unique allows reusing an id that already exists in debian-slim.
RUN groupadd --non-unique --gid "$AGENT_GID" agent \
    && useradd --non-unique --uid "$AGENT_UID" --gid "$AGENT_GID" -m -s /bin/bash agent

# Clone entrypoint. It is fully SELF-CONTAINED: it has its own inline one-shot
# credential helper and does NOT source the shared git-credentials.sh library, so
# that library is intentionally NOT copied into this image — keeping the attack
# surface minimal for untrusted-repo network I/O. (When v2 adds SSH / custom-host
# support that needs the shared lib, COPY it back in then.)
COPY docker/scripts/clone-entrypoint.sh /clone-entrypoint.sh
RUN chmod 0755 /clone-entrypoint.sh

# Run as the unprivileged agent user. The worker mounts the staging dir owned by
# this uid; the container needs no root, no extra capabilities, no docker socket.
USER agent
WORKDIR /home/agent

# tini as PID 1 so `docker stop` / the worker timeout cleanly terminates git and
# reaps any children.
ENTRYPOINT ["/usr/bin/tini", "--", "/clone-entrypoint.sh"]
