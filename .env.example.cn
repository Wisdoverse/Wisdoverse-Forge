# .env.example.cn
# China mainland mirror configuration for Docker builds.
# Usage: cp .env.example.cn .env.local
# Revert: rm .env.local
#
# These variables are consumed by Makefile (DOCKER_CN_ARGS) and
# docker-compose (build.args). They are passed as --build-arg to
# all Dockerfiles automatically.
REGION=cn
NPM_REGISTRY=https://registry.npmmirror.com
GOPROXY=https://goproxy.cn,direct
ALPINE_MIRROR=https://mirrors.aliyun.com/alpine
DOCKER_MIRROR=https://mirrors.aliyun.com/docker-ce
GITHUB_PROXY=https://ghfast.top/
GHCR_MIRROR=ghcr.m.daocloud.io
