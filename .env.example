# =============================================================================
#                      WISDOVERSE FORGE CONFIGURATION
# =============================================================================
#
# Environment Configuration Template
# Version: 2.0.0
# Last Updated: 2026-01-26
#
# SETUP:
#   1. Copy this file: cp .env.example .env
#   2. Fill in required values (marked with [REQUIRED])
#   3. Generate secrets: openssl rand -base64 64
#   4. After the app is running, create the initial owner/admin account through
#      the web setup flow. No default application admin account is configured here.
#
# ENVIRONMENTS:
#   - Development: .env (gitignored)
#   - Production:  .env.production (gitignored, use secrets manager)
#   - Testing:     .env.test (gitignored)
#
# NAMING CONVENTIONS:
#   - Boolean: Use "true" or "false" (lowercase)
#   - Duration: Use suffix (s=seconds, m=minutes, h=hours, d=days)
#   - Size: Use suffix (KB, MB, GB) or bytes
#
# =============================================================================

# -----------------------------------------------------------------------------
# CORE SETTINGS
# -----------------------------------------------------------------------------

# Application environment
# Values: development | staging | production | test
# Default: development
NODE_ENV=development

# Application name (used in logs, metrics, etc.)
APP_NAME=wisdoverse-forge

# Application version (auto-detected from package.json if not set)
# APP_VERSION=1.0.0

# -----------------------------------------------------------------------------
# SERVER
# -----------------------------------------------------------------------------

# HTTP server port
# Range: 1024-65535
# Default: 4003
AGENTFORGE_PORT=4003

# HTTP server bind address
# Use 0.0.0.0 for all interfaces, 127.0.0.1 for localhost only
# Default: 0.0.0.0
AGENTFORGE_HOST=0.0.0.0

# Public URL for callbacks, webhooks, OAuth redirects
# [REQUIRED in production]
# Example: https://forge.example.com
BASE_URL=http://localhost:4003

# Trust reverse proxy headers (X-Forwarded-For, X-Real-IP, X-Forwarded-Proto)
# Set to "true" when behind nginx, cloudflare, or load balancer
# Default: false
TRUST_PROXY=false

# Allowed CORS origins (comma-separated)
# Supports wildcards: *.example.com
# Default: http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:4003

# -----------------------------------------------------------------------------
# DATABASE (PostgreSQL)
# -----------------------------------------------------------------------------

# Database connection method
# Option 1: Individual parameters (recommended)
# Option 2: Connection URL (DATABASE_URL)

# PostgreSQL host
# Default: localhost
DB_HOST=localhost

# PostgreSQL port
# Default: 5432
DB_PORT=5432

# Database name
# [REQUIRED]
DB_NAME=agentforge

# Database user
# [REQUIRED]
DB_USER=agentforge

# Database password
# [REQUIRED] [SENSITIVE]
# Generate: openssl rand -base64 32
DB_PASSWORD=

# Enable SSL/TLS for database connection
# Required for most cloud providers (RDS, Cloud SQL, etc.)
# Default: false
DB_SSL=false

# Connection pool settings
# Max connections (adjust based on: max_connections / num_instances)
# Default: 20
DB_POOL_MAX=20

# Idle connection timeout (milliseconds)
# Default: 30000
DB_IDLE_TIMEOUT=30000

# Connection timeout (milliseconds)
# Default: 5000
DB_CONNECT_TIMEOUT=5000

# Alternative: Full connection URL
# Format: PostgreSQL connection URL for your database and sslmode policy
# DATABASE_URL=

# Enable query logging (development only)
# Default: false
DB_LOG_QUERIES=false

# -----------------------------------------------------------------------------
# REDIS
# -----------------------------------------------------------------------------

# Enable Redis (required for multi-instance deployments)
# Default: false
REDIS_ENABLED=false

# Redis host
# Default: localhost
REDIS_HOST=localhost

# Redis port
# Default: 6379
REDIS_PORT=6379

# Redis password
# [SENSITIVE] Leave empty if no authentication
REDIS_PASSWORD=

# Redis database number
# Range: 0-15
# Default: 0
REDIS_DB=0

# Key prefix for namespacing
# Default: agentforge:
REDIS_PREFIX=agentforge:

# Enable TLS for Redis connection
# Default: false
REDIS_TLS=false

# Alternative: Full connection URL
# Format: redis://[:password@]host:port[/database]
# REDIS_URL=

# -----------------------------------------------------------------------------
# AUTHENTICATION
# -----------------------------------------------------------------------------

# JWT signing secret
# [REQUIRED] [SENSITIVE]
# Generate: openssl rand -base64 64
# Minimum: 32 characters, recommended: 64+ characters
JWT_SECRET=

# Note: JWT expiry and issuer are currently hardcoded in TokenService.
# Access token: 15m, Refresh token: 7d, Issuer: 'agentforge'
# To customize, wire JWT_EXPIRY / JWT_REFRESH_EXPIRY / JWT_ISSUER through config/env.ts.

# BCrypt rounds for password hashing
# Range: 10-14 (higher = more secure but slower)
# Default: 12
BCRYPT_ROUNDS=12

# -----------------------------------------------------------------------------
# OAUTH2 PROVIDERS
# -----------------------------------------------------------------------------

# GitHub OAuth2
# Setup: https://github.com/settings/developers
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Google OAuth2
# Setup: https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# CLI auth proxy refresh behavior
# Consecutive invalid_grant refresh failures before revoking stored CLI credentials.
# Default: 2
CLI_AUTH_PROXY_REVOKE_THRESHOLD=2

# -----------------------------------------------------------------------------
# RATE LIMITING
# -----------------------------------------------------------------------------

# Enable rate limiting
# Default: true in production, false in development
RATE_LIMIT_ENABLED=true

# Time window for rate limiting (milliseconds)
# Default: 60000 (1 minute)
RATE_LIMIT_WINDOW_MS=60000

# Maximum requests per window
# Default: 100
RATE_LIMIT_MAX_REQUESTS=100

# Rate limit by organization (multi-tenant)
# Default: true
RATE_LIMIT_BY_ORG=true

# -----------------------------------------------------------------------------
# FEATURE FLAGS
# -----------------------------------------------------------------------------

# Enable multi-tenant SaaS features
# Default: false
ENABLE_MULTI_TENANCY=false

# Enable webhook notifications
# Default: false
ENABLE_WEBHOOKS=false

# Enable voice input (requires DEEPGRAM_API_KEY)
# Default: false
ENABLE_VOICE_INPUT=false

# Enable file uploads
# Default: true
ENABLE_FILE_UPLOAD=true

# Enable real-time sync via WebSocket
# Default: true
ENABLE_REALTIME_SYNC=true

# Enable analytics collection
# Default: false
ENABLE_ANALYTICS=false

# Enable experimental features (use with caution)
# Default: false
ENABLE_EXPERIMENTAL=false

# -----------------------------------------------------------------------------
# WEBSOCKET
# -----------------------------------------------------------------------------

# Enable WebSocket server
# Default: true
WEBSOCKET_ENABLED=true

# Maximum concurrent WebSocket connections
# Default: 1000
WS_MAX_CONNECTIONS=1000

# Maximum message size (bytes)
# Default: 65536 (64KB)
WS_MAX_MESSAGE_SIZE=65536

# Heartbeat interval (milliseconds)
# Default: 30000 (30 seconds)
WS_HEARTBEAT_INTERVAL=30000

# Connection timeout (milliseconds)
# Default: 45000 (45 seconds)
WS_CONNECTION_TIMEOUT=45000

# -----------------------------------------------------------------------------
# STORAGE (MinIO / Local)
# -----------------------------------------------------------------------------

# Storage provider
# Values: local | minio
# Default: local
STORAGE_PROVIDER=local

# Local storage path (when STORAGE_PROVIDER=local)
# Default: ~/.agentforge/data/uploads
STORAGE_LOCAL_PATH=~/.agentforge/data/uploads

# Maximum file size (bytes)
# Default: 10485760 (10MB)
STORAGE_MAX_FILE_SIZE=10485760

# Maximum files per session
# Default: 20
STORAGE_MAX_FILES_PER_SESSION=20

# Signed URL expiry (seconds)
# Default: 3600 (1 hour)
STORAGE_SIGNED_URL_EXPIRY=3600

# MinIO Configuration (when STORAGE_PROVIDER=minio)
# Endpoint format: host:port (without protocol)
MINIO_ENDPOINT=localhost:9000

# MinIO access credentials
# [REQUIRED when using MinIO] [SENSITIVE]
# Generate unique credentials for each environment.
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# MinIO bucket name
# Default: agentforge
MINIO_BUCKET=agentforge

# Enable SSL for MinIO
# Default: false
MINIO_USE_SSL=false

# MinIO region (optional)
# MINIO_REGION=us-east-1

# -----------------------------------------------------------------------------
# LOGGING
# -----------------------------------------------------------------------------

# Log level
# Values: debug | info | warn | error
# Default: info (production), debug (development)
LOG_LEVEL=info

# Log format
# Values: json | pretty
# Default: json (production), pretty (development)
LOG_FORMAT=pretty

# Log file path (optional, logs to stdout if not set)
# LOG_FILE=/var/log/agentforge/app.log

# Enable request logging
# Default: true
LOG_REQUESTS=true

# Enable SQL query logging (development only)
# Default: false
LOG_SQL=false

# -----------------------------------------------------------------------------
# EXTERNAL SERVICES
# -----------------------------------------------------------------------------

# Deepgram API (voice transcription)
# Get key: https://console.deepgram.com/
# DEEPGRAM_API_KEY=

# Stripe (billing)
# Get keys: https://dashboard.stripe.com/apikeys
# STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET must be configured together.
# Webhook endpoint: ${BASE_URL}/api/billing/webhook
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PUBLISHABLE_KEY=

# Sentry (error tracking)
# Get DSN: https://sentry.io/
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.1

# OpenAI (optional AI features)
# Get key: https://platform.openai.com/
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4

# -----------------------------------------------------------------------------
# MONITORING & METRICS
# -----------------------------------------------------------------------------

# Enable Prometheus metrics endpoint
# Default: false
METRICS_ENABLED=false

# Metrics endpoint path
# Default: /metrics
METRICS_ENDPOINT=/metrics

# Enable health check endpoints
# Default: true
HEALTH_CHECK_ENABLED=true

# -----------------------------------------------------------------------------
# SECURITY
# -----------------------------------------------------------------------------

# API key for server-to-server authentication
# [SENSITIVE] Generate: openssl rand -base64 32
# AGENTFORGE_API_KEY=

# Allowed hosts (comma-separated, empty for all)
# Example: wisdoverse.com,api.wisdoverse.com
ALLOWED_HOSTS=

# Enable HTTPS redirect (when behind TLS-terminating proxy)
# Default: false
FORCE_HTTPS=false

# Content Security Policy
# Default: See security middleware
# CSP_DIRECTIVES=

# Extra SSH known_hosts entries for self-hosted Git servers (newline-separated)
# Used by agent containers to connect to private Git repos
# EXTRA_SSH_KNOWN_HOSTS=

# Extra SSH hostnames to add to the SSH config Host line (space-separated)
# EXTRA_SSH_HOSTS=

# Self-hosted GitLab SSH rewrites for agent containers (comma-separated)
# Format: ssh_host=https_url (e.g., ssh.gitlab.example.com=https://gitlab.example.com/)
# SELF_HOSTED_GITLAB_SSH=

# -----------------------------------------------------------------------------
# DEVELOPMENT ONLY
# -----------------------------------------------------------------------------
# WARNING: Never enable these in production!

# Enable debug mode
# DEBUG=true

# Skip authentication (dangerous!)
# SKIP_AUTH=true

# Seed database with test data
# SEED_DATABASE=true

# =============================================================================
# END OF CONFIGURATION
# =============================================================================
