{
  "name": "wisdoverse-forge",
  "version": "0.1.15",
  "description": "Self-hosted governed AI workbench for tasks, runs, context, skills, and runtime execution",
  "author": "nearcyan",
  "license": "LicenseRef-Wisdoverse-Forge-BSL-1.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/Wisdoverse/Wisdoverse-Forge"
  },
  "bugs": {
    "url": "https://github.com/Wisdoverse/Wisdoverse-Forge/issues"
  },
  "homepage": "https://github.com/Wisdoverse/Wisdoverse-Forge#readme",
  "keywords": [
    "ai",
    "ai-agents",
    "llm",
    "workflow",
    "workbench",
    "governance",
    "skills",
    "context",
    "self-hosted"
  ],
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "files": [
    "hooks/",
    "dist/",
    "!dist/**/*.map"
  ],
  "scripts": {
    "dev": "npm run dev:client",
    "dev:client": "vite",
    "build": "npm run build:client",
    "build:client": "tsc && vite build",
    "preview": "vite preview",
    "server": "cargo run --manifest-path rust/Cargo.toml --bin agentforge-server",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build",
    "version": "./scripts/sync-version.sh",
    "test": "vitest run --config tests/vitest.config.ts",
    "test:unit": "vitest run --config tests/vitest.config.ts --project unit --project unit-app",
    "test:integration": "vitest run --config tests/vitest.config.ts --project integration --passWithNoTests",
    "test:watch": "vitest --config tests/vitest.config.ts",
    "test:coverage": "vitest run --config tests/vitest.config.ts --project unit --project unit-app --coverage && node scripts/check-critical-coverage.cjs",
    "test:ui": "vitest --config tests/vitest.config.ts --ui",
    "test:e2e": "npx playwright test --config tests/e2e/playwright.config.ts",
    "test:e2e:orchestration:real-cli": "bash scripts/run-orchestration-real-cli-e2e.sh",
    "migrate": "cargo run --manifest-path rust/Cargo.toml --bin agentforge-server -- --migrate-only",
    "migrate:prod": "cargo run --manifest-path rust/Cargo.toml --bin agentforge-server -- --migrate-only",
    "migrate:down": "node scripts/rust-migrate-unsupported.mjs down",
    "migrate:status": "node scripts/rust-migrate-unsupported.mjs status",
    "pr:summary": "node scripts/pr-status-summary.mjs",
    "pr:summary:local": "node scripts/pr-status-summary.mjs --local-only",
    "pr:summary:refresh": "node scripts/pr-status-summary.mjs --refresh",
    "pr:summary:force-refresh": "node scripts/pr-status-summary.mjs --force-refresh",
    "pr:summary:monitor": "node scripts/pr-status-summary.mjs --monitor",
    "beginner:ux:copy": "node scripts/check-beginner-ux-copy.mjs",
    "fsd:check": "node scripts/check-fsd-boundaries.mjs",
    "lint": "npm run fsd:check && npm run beginner:ux:copy && eslint shared scripts src/app",
    "lint:fix": "eslint shared scripts src/app --fix",
    "format:check": "prettier --check \"shared/**/*.ts\" \"src/**/*.ts\"",
    "format": "prettier --write \"shared/**/*.ts\" \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "proto:gen": "npm run proto:gen:platform",
    "proto:gen:platform": "mkdir -p shared/generated/platform && protoc --plugin=./node_modules/.bin/protoc-gen-ts_proto --ts_proto_out=shared/generated/platform --ts_proto_opt=outputServices=grpc-js,esModuleInterop=true,env=node,useExactTypes=false -I=rust/crates/platform/proto rust/crates/platform/proto/*.proto && sed -i 's|from \"./common\"|from \"./common.js\"|g' shared/generated/platform/*.ts && prettier --write 'shared/generated/platform/*.ts'",
    "proto:check": "npm run proto:gen && git diff --exit-code shared/generated/platform/"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.12.0",
    "@dnd-kit/core": "^6.3.1",
    "@grpc/grpc-js": "^1.14.4",
    "@tanstack/react-router": "^1.170.15",
    "@tanstack/react-virtual": "^3.14.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "i18next": "^26.3.1",
    "lucide-react": "^1.17.0",
    "@nats-io/transport-node": "^3.4.0",
    "pg": "^8.21.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.78.0",
    "react-i18next": "^17.0.7",
    "tailwind-merge": "^3.6.0",
    "three": "^0.184.0",
    "zustand": "^5.0.14"
  },
  "overrides": {
    "flatted": ">=3.4.0",
    "undici": "7.25.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.4.0",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.9.2",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.6",
    "@vitest/ui": "^4.1.6",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.3.0",
    "ts-proto": "^2.11.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8",
    "yaml": "^2.9.0"
  }
}
